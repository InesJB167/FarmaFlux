// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model categorias {
  id          Int       @id @default(autoincrement())
  nome        String    @db.VarChar(100)
  descricao   String?   @db.Text
  deleted_at  DateTime?
  created_at  DateTime  @default(now())
  farmacia_id Int
  farmacia    farmacia  @relation(fields: [farmacia_id], references: [id])

  medicamentos medicamentos[]

  //restrição de unicidade composta
  @@unique([farmacia_id, nome])
}

model localizacoes {
  id          Int       @id @default(autoincrement())
  zona        String    @db.VarChar(100)
  estante     String    @db.VarChar(50)
  nivel       String    @db.VarChar(50)
  descricao   String?   @db.VarChar(200)
  deleted_at  DateTime?
  farmacia_id Int
  farmacia    farmacia  @relation(fields: [farmacia_id], references: [id])

  medicamentos medicamentos[]
}

model medicamentos {
  id              Int       @id @default(autoincrement())
  nome            String    @db.VarChar(100)
  principio_ativo String?
  dosagem         String?
  preco_venda     Decimal   @db.Decimal(15, 2)
  stock_minimo    Int
  deleted_at      DateTime?

  // Foreign Keys
  categoria_id   Int
  localizacao_id Int
  taxa_iva_id    Int
  farmacia_id    Int

  // Relações
  categoria   categorias   @relation(fields: [categoria_id], references: [id])
  localizacao localizacoes @relation(fields: [localizacao_id], references: [id])
  taxas_ivas  taxas_iva    @relation(fields: [taxa_iva_id], references: [id])
  farmacia    farmacia     @relation(fields: [farmacia_id], references: [id])

  barcodes    barcodes[]
  lotes       lotes[]
  itensVendas itens_venda[]
}

model barcodes {
  id             Int       @id @default(autoincrement())
  medicamento_id Int
  codigo         String
  deleted_at     DateTime?
  farmacia_id    Int

  // Relações
  medicamentos medicamentos @relation(fields: [medicamento_id], references: [id])
  farmacia     farmacia     @relation(fields: [farmacia_id], references: [id])

  //restrição de unicidade composta
  @@unique([farmacia_id, codigo])
}

model fornecedores {
  id           Int       @id @default(autoincrement())
  nome_empresa String    @db.VarChar(150)
  nif          String    @db.VarChar(20)
  contacto     String    @db.VarChar(50)
  endereco     String    @db.VarChar(200)
  created_at   DateTime  @default(now())
  deleted_at   DateTime?
  farmacia_id  Int
  farmacia     farmacia  @relation(fields: [farmacia_id], references: [id])

  lotes lotes[]

  //restrição de unicidade composta
  @@unique([farmacia_id, nif])
}

model lotes {
  id Int @id @default(autoincrement())

  // Foreign Keys
  medicamento_id Int
  fornecedor_id  Int

  numero_lote    String
  data_validade  DateTime
  qtd_inicial    Int
  qtd_atual      Int
  preco_custo    Decimal   @db.Decimal(15, 2)
  nif_fornecedor String    @db.VarChar(20)
  data_entrada   DateTime  @default(now())
  created_at     DateTime  @default(now())
  deleted_at     DateTime?
  updated_at     DateTime  @default(now())

  // Relações
  fornecedor  fornecedores @relation(fields: [fornecedor_id], references: [id])
  medicamento medicamentos @relation(fields: [medicamento_id], references: [id])

  itemRetiradoLotes item_retirado_lote[]
}

enum Role {
  SUPER_ADMIN
  ADMIN
  GERENTE
  OPERADOR
}

// -Podes guardar quem aprovou.
//  -Data da aprovação.

enum StatusConta {
  PENDENTE
  ATIVO
  INATIVO
  REJEITADO
}

model utilizadores {
  id            Int         @id @default(autoincrement())
  nome          String      @db.VarChar(100)
  username      String      @db.VarChar(50)
  password_hash String      @db.VarChar(255)
  role          Role        @default(OPERADOR)
  status        StatusConta @default(PENDENTE)
  created_at    DateTime    @default(now())
  deleted_at    DateTime?
  updated_at    DateTime    @updatedAt
  approved_at   DateTime?
  rejected_at   DateTime?
  approved_by   Int? //chave estrngeira referenciando a mesma tabela
  rejected_by   Int?
  deleted_by    Int?
  farmacia_id   Int?

  approvedBy utilizadores? @relation("AdminAprovacao", fields: [approved_by], references: [id])
  rejectedBy utilizadores? @relation("AdminReprovacao", fields: [rejected_by], references: [id])
  deletedBy  utilizadores? @relation("AdminDelete", fields: [deleted_by], references: [id])
  farmacia   farmacia?     @relation(fields: [farmacia_id], references: [id])

  approvedUsers utilizadores[] @relation("AdminAprovacao")
  rejectedUsers utilizadores[] @relation("AdminReprovacao")
  deletedUsers  utilizadores[] @relation("AdminDelete")

  vendas            vendas[]
  logs_auditoria    logs_auditoria[]
  tenants           tenants[]
  planos_licenca    planos_licenca[]
  pagamento_licenca pagamento_licenca[]
  codigos_ativacao  codigos_ativacao[]

  //restrição de unicidade composta
  @@unique([farmacia_id, username])
}

enum Status {
  DRAFT
  PARKED
  COMPLETED
  CANCELLED
}

model vendas {
  id Int @id @default(autoincrement())

  //Foreign Keys
  utilizador_id Int
  cliente_id    Int

  data_hora      DateTime  @default(now())
  total_bruto    Decimal   @db.Decimal(15, 2)
  total_desconto Decimal   @db.Decimal(15, 2)
  status         Status    @default(DRAFT)
  created_at     DateTime  @default(now())
  updated_at     DateTime?
  farmacia_id    Int

  //Relações
  utilizador utilizadores @relation(fields: [utilizador_id], references: [id])
  cliente    clientes     @relation(fields: [cliente_id], references: [id])
  farmacia   farmacia     @relation(fields: [farmacia_id], references: [id])

  itens_venda   itens_venda[]
  pagamentos    pagamentos[]
  notas_credito notas_credito[]

  fatura fatura?
}

model itens_venda {
  id Int @id @default(autoincrement())

  //Foreign Keys
  venda_id       Int
  medicamento_id Int

  quantidade     Int
  preco_unitario Decimal @db.Decimal(15, 2)
  subtotal       Decimal @db.Decimal(15, 2)

  //Relações
  venda       vendas       @relation(fields: [venda_id], references: [id])
  medicamento medicamentos @relation(fields: [medicamento_id], references: [id])

  itemRetiradoLotes item_retirado_lote[]
}

model item_retirado_lote {
  id_lote       Int
  id_item_venda Int
  quantidade    Int

  lote       lotes       @relation(fields: [id_lote], references: [id])
  item_venda itens_venda @relation(fields: [id_item_venda], references: [id])

  @@id([id_lote, id_item_venda])
}

enum Metodo {
  DINHEIRO
  TPA
  TRANSFERENCIA
}

model pagamentos {
  id Int @id @default(autoincrement())

  //Foreign Keys
  venda_id Int

  metodo            Metodo   @default(DINHEIRO)
  valor_pago        Decimal  @db.Decimal(15, 2)
  troco             Decimal? @db.Decimal(15, 2)
  referencia_manual String?  @db.VarChar(100)
  created_at        DateTime @default(now())

  //Relações
  venda vendas @relation(fields: [venda_id], references: [id])
}

enum Acao {
  CREATE
  LOGIN
  UPDATE
  DELETE
  CANCELAR_VENDA
  AJUSTE_STOCK
  ALTERAR_PRECO
  ALTERAR_ROLE
  GERAR_NOTA_CREDITO
}

model logs_auditoria {
  id Int @id @default(autoincrement())

  //Foreign Keys
  utilizador_id Int
  farmacia_id   Int?

  acao         Acao     @default(UPDATE)
  tabela       String
  id_registro  Int
  valor_antigo Json? //deve vir em json pra evitar erros 
  valor_novo   Json?
  created_at   DateTime @default(now())

  //Relações
  utilizador utilizadores @relation(fields: [utilizador_id], references: [id])
  farmacia   farmacia?    @relation(fields: [farmacia_id], references: [id])
}

model farmacia {
  id                          Int    @id @default(autoincrement())
  nif                         String @unique @db.VarChar(20)
  razao_social                String
  nome_comercial              String @db.VarChar(100)
  provincia                   String @default("Luanda")
  morada                      String @db.VarChar(100)
  telefone                    String @db.VarChar(100)
  numero_certificado_software String

  //dados para licenciamento da farmacia
  tenant_id_fk Int     @unique
  tenant       tenants @relation(fields: [tenant_id_fk], references: [id])

  categorias     categorias[]
  localizacoes   localizacoes[]
  fornecedores   fornecedores[]
  medicamentos   medicamentos[]
  utilizadores   utilizadores[]
  clientes       clientes[]
  vendas         vendas[]
  logs_auditoria logs_auditoria[]
  notas_credito  notas_credito[]
  fatura         fatura[]
  barcodes       barcodes[]
}

model clientes {
  id          Int     @id @default(autoincrement())
  nif         String  @db.VarChar(20)
  nome        String  @db.VarChar(200)
  endereco    String?
  provincia   String  @default("Luanda")
  farmacia_id Int

  farmacia farmacia @relation(fields: [farmacia_id], references: [id])

  vendas vendas[]

  //restrição de unicidade composta
  @@unique([farmacia_id, nif])
}

model taxas_iva {
  id                     Int            @id @default(autoincrement())
  codigo_legal           String         @unique
  percentagem            Decimal        @db.Decimal(5, 2)
  motivo_de_insercao_iva String
  medicamentos           medicamentos[]
}

enum motivo_nota_credito {
  ERRO_FATURACAO
  DEVOLUCAO_PRODUTO
  PRODUTO_DEFEITUOSO
  ANULACAO_VENDA
  DESCONTO_POS_VENDA
  TROCA_PRODUTO
  OUTRO
}

model notas_credito {
  id Int @id @default(autoincrement())

  venda_id Int

  motivo            motivo_nota_credito @default(ERRO_FATURACAO)
  valor_anulado     Decimal             @db.Decimal(15, 2)
  numero_sequencial Int
  codigo_nota       String
  data_emissao      DateTime            @default(now())
  hash_assinatura   String
  hash_anterior     String?
  farmacia_id       Int

  venda    vendas   @relation(fields: [venda_id], references: [id])
  farmacia farmacia @relation(fields: [farmacia_id], references: [id])

  //restrição de unicidade composta
  @@unique([codigo_nota, farmacia_id])
}

model fatura {
  id            Int    @id @default(autoincrement())
  codigo_fatura String
  serie         String
  ano           Int
  sequencial    Int
  farmacia_id   Int

  venda_id Int      @unique
  venda    vendas   @relation(fields: [venda_id], references: [id])
  farmacia farmacia @relation(fields: [farmacia_id], references: [id])

  hash_assinatura String?
  hash_anterior   String?
  created_at      DateTime @default(now())

  //restrição de unicidade composta
  @@unique([serie, ano, sequencial])
  @@unique([farmacia_id, codigo_fatura])
}

//PARTE DO LICENCIAMENTO 

enum estado_tenants {
  ATIVO
  PENDENTE
  SUSPENSO
  CANCELADO
}

enum tipo_periodo_licenca {
  MENSAL // LCM
  TRIMESTRAL // LCT
  SEMESTRAL // LCS
  ANUAL // LCA
}

enum metodo_pagamento_licenca {
  DINHEIRO
  TRANSFERENCIA
}

model tenants {
  id                     Int            @id @default(autoincrement())
  tenant_id              String         @unique
  estado                 estado_tenants @default(PENDENTE)
  data_proximo_pagamento DateTime?
  limite_dispositivos    Int            @default(5)
  created_at             DateTime       @default(now())
  utilizador_id          Int

  utilizador utilizadores @relation(fields: [utilizador_id], references: [id])

  dispositivos     dispositivos[]
  codigos_ativacao codigos_ativacao[]
  pagamentos       pagamento_licenca[]
  farmacia         farmacia?
}

model dispositivos {
  id            Int      @id @default(autoincrement())
  tenant_id_fk  Int
  device_id     String   @unique @db.VarChar(38) //aqui vai o UUI(universally unique identifier) 
  fingerPrint   String   @db.VarChar(255) //o fingerPrint gerado
  token_jwt     String?  @db.VarChar(500)
  data_ativacao DateTime @default(now())
  ultimo_acesso DateTime @default(now())
  ativo         Boolean  @default(true)

  tenant tenants @relation(fields: [tenant_id_fk], references: [id])
}

model codigos_ativacao {
  id            Int       @id @default(autoincrement())
  codigo        String    @unique @db.VarChar(8)
  tenant_id_fk  Int
  codigo_usado  Boolean   @default(false)
  expira_em     DateTime?
  created_at    DateTime  @default(now())
  utilizador_id Int

  utilizador utilizadores @relation(fields: [utilizador_id], references: [id])
  tenant     tenants      @relation(fields: [tenant_id_fk], references: [id])
}

model planos_licenca {
  id            Int                  @id @default(autoincrement())
  codigo        String               @unique @db.VarChar(10) // LCM, LCT, LCS, LCA
  tipo          tipo_periodo_licenca
  custo         Decimal              @db.Decimal(10, 2)
  duracao_dias  Int //ex.:  30, 90, 180, 365
  utilizador_id Int
  utilizador    utilizadores         @relation(fields: [utilizador_id], references: [id])
  pagamentos    pagamento_licenca[]
}

model pagamento_licenca {
  id             Int                      @id @default(autoincrement())
  tenant_id_fk   Int
  plano_id       Int
  valor_pago     Decimal                  @db.Decimal(10, 2)
  metodo         metodo_pagamento_licenca @default(TRANSFERENCIA)
  data_pagamento DateTime                 @default(now())
  data_inicio    DateTime // quando a licença começa a valer
  data_fim       DateTime // quando a licença termina
  created_at     DateTime                 @default(now())
  referencia     String                   @unique //a referencia bancaria usada
  utilizador_id  Int

  utilizador utilizadores   @relation(fields: [utilizador_id], references: [id])
  tenant     tenants        @relation(fields: [tenant_id_fk], references: [id])
  plano      planos_licenca @relation(fields: [plano_id], references: [id])
}
